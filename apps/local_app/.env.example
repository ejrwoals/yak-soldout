# =============================================================================
# 스택 2 — 로컬 PyWebView 앱 환경변수
# =============================================================================
# 역할: Supabase에서 status='pending' 주문을 읽어 크롤링(장바구니 담기)하고,
#       결과(cart_status)와 상태(ordered)를 다시 write-back. 규격수집 크롤링도 여기.
# 사용:  cp local_app/.env.example local_app/.env   후 값 채우기 (.env 는 커밋 금지)
# =============================================================================

# Supabase 프로젝트 URL
SUPABASE_URL=https://pdtsciusfgzvozohefbt.supabase.co

# anon public key — Project Settings → API → "anon public".
# RLS로 보호되므로 로컬 앱에 안전하게 둘 수 있음. (service_role key는 로컬 앱에 넣지 말 것)
SUPABASE_ANON_KEY=

# 앱 로컬 서버 포트 (PyWebView 창이 이 주소를 로드). 비면 8080 사용.
PORT=8080
