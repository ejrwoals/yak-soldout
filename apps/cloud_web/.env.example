# =============================================================================
# 스택 1 — Cloud Run 웹 UI 환경변수
# =============================================================================
# 역할: 약국 사람이 사진 업로드 → OCR(Gemini) → 검토·수정 → Supabase 저장(status=pending).
# 로컬 개발용 파일. 배포 시에는 이 값들을 Cloud Run 환경변수 + Secret Manager로 주입한다.
# 사용:  cp cloud_web/.env.example cloud_web/.env   후 값 채우기 (.env 는 커밋 금지)
# =============================================================================

# Supabase 프로젝트 URL
SUPABASE_URL=https://pdtsciusfgzvozohefbt.supabase.co

# anon public key — 로그인/사용자 세션 컨텍스트용. (Project Settings → API → "anon public")
SUPABASE_ANON_KEY=

# service_role key — 서버 전용 관리 작업용.
# ★ 절대 클라이언트/브라우저/도커 이미지에 노출 금지 → 배포 시 Secret Manager로만 주입.
SUPABASE_SERVICE_KEY=

# OCR (Gemini) — 배포 시 Secret Manager로 주입. 이미지에 굽지 말 것.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 서버 포트 — Cloud Run이 런타임에 $PORT를 주입(기본 8080). 로컬 개발 기본값도 8080.
PORT=8080

# -----------------------------------------------------------------------------
# 참고: Google 로그인(OAuth) 클라이언트 ID/보안비밀은 이 .env 가 아니라
#   Supabase 대시보드 → Authentication → Providers → Google 에 입력한다.
#   (앱 코드는 Supabase Auth를 통해서만 Google 로그인을 다루므로 여기 둘 필요 없음)
# -----------------------------------------------------------------------------
