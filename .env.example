# 손글씨 주문지 OCR 기능용 환경변수
# 이 파일을 .env 로 복사한 뒤 실제 키를 채워주세요. (.env 는 git 에 커밋되지 않습니다)
#
#   cp .env.example .env
#
# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 사용할 Gemini 모델. 미설정 시 gemini-2.5-flash 사용.
# 어려운 필체는 gemini-2.5-pro 로 폴백 가능.
GEMINI_MODEL=gemini-2.5-flash
